# Path to yt-dlp binary (default: "yt-dlp", resolves from PATH)
# YT_DLP_PATH=yt-dlp

# Path to Netscape-format cookies file for authenticated YouTube requests
# (age-restricted, member-only, or private videos)
# Defaults to data/cookies.txt — can be uploaded via the room UI
# YT_DLP_COOKIES=/data/cookies.txt

# Spotify Web API credentials
# Create a Spotify App at https://developer.spotify.com/dashboard
# Add http://localhost:3000/api/spotify/callback as a Redirect URI
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Public client ID for frontend OAuth redirect (visible in Spotify App settings)
# NUXT_PUBLIC_SPOTIFY_CLIENT_ID=

# PORT=3000
